# Copy to .env (git-ignored) and fill in for your own deployment.
NOTES_DOMAIN=notes.example.com
NOTES_HOSTED_ZONE=example.com
# Globally unique; becomes https://<prefix>.auth.<region>.amazoncognito.com
NOTES_AUTH_PREFIX=example-notes
# Optional: security alerts (KMS key disabled, root sign-in). Confirm the email AWS sends once.
NOTES_ALERT_EMAIL=you@example.com
